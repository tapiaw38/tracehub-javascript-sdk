{
  "name": "@tracehub/sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for TraceHub - Send traces and logs to your TraceHub server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tracehub",
    "logging",
    "tracing",
    "monitoring",
    "observability",
    "error-tracking"
  ],
  "author": "TraceHub Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tapiaw38/tracehub-javascript-sdk.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
